# ================================
# Flat Expense Tracker - FRONTEND PRODUCTION
# ================================
# The Docker deployment serves React and FastAPI from the same origin.
# Leave VITE_API_URL empty so the browser calls /api on the deployed domain.
# If the frontend is deployed separately, set this to the public API URL, e.g.:
# VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=
