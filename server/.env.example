# Flat Expense & Payment Manager Environment Configuration

# Database Connection URL:
# For local development with SQLite:
# DATABASE_URL=sqlite:///./flat_expenses.db
# For PostgreSQL (e.g. Render / Supabase / Neon):
DATABASE_URL=postgresql://flat_payment_tracker_user:PASSWORD@dpg-host-a/flat_payment_tracker

# CORS Allowed Origins (Comma-separated list, single URL, or * for all):
# Examples:
# CORS_ORIGINS=https://flat-payment-tracker.onrender.com,http://localhost:5173,http://localhost:8000
# CORS_ORIGINS=https://flat-payment-tracker.onrender.com
CORS_ORIGINS=https://flat-payment-tracker.onrender.com
